TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ---------- Monitoring ----------
BETTERSTACK_HEARTBEAT_URL=

# ---------- Operational ----------
PORT=3001
LOG_LEVEL=info
DRY_RUN=true
DRY_RUN_TIME_SCALE=1
MAX_DAILY_SOL_DEPLOYED=50
BOT_HOT_WALLET_MAX_BALANCE_SOL=5
