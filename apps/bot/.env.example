# ---------- Solana RPC ----------
HELIUS_API_KEY=
QUICKNODE_RPC_URL=
NETWORK=mainnet-beta              # or "devnet"

# ---------- Token ----------
PULSE_MINT_ADDRESS=               # set post-launch
PULSE_TOTAL_SUPPLY=1000000000
PULSE_DECIMALS=6

# ---------- Wallet keys (base58; keep secret) ----------
BOT_WALLET_PRIVATE_KEY=
BURN_VAULT_PRIVATE_KEY=
DEFENSE_VAULT_PRIVATE_KEY=
REWARDS_VAULT_PRIVATE_KEY=
LIQUIDITY_VAULT_PRIVATE_KEY=
OPERATIONS_VAULT_PRIVATE_KEY=

# ---------- Vault public addresses ----------
DECISION_VAULT_ADDRESS=
DEFENSE_VAULT_ADDRESS=
REWARDS_VAULT_ADDRESS=
LIQUIDITY_VAULT_ADDRESS=
OPERATIONS_VAULT_ADDRESS=

# ---------- Trading infrastructure ----------
JUPITER_API_URL=https://quote-api.jup.ag/v6
JITO_AUTH_KEYPAIR=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# ---------- Database (Replit Hosted Postgres) ----------
# Use the connection string Replit gives you under "Database" → "Connection details".
DATABASE_URL=postgres://user:password@host:5432/pulse
# Optional: separate read-only URL for dashboard tooling.
DATABASE_URL_READONLY=

# ---------- Pricing ----------
BIRDEYE_API_KEY=

# ---------- Social ----------
