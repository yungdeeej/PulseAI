# ---------- Solana RPC ----------
HELIUS_API_KEY=
QUICKNODE_RPC_URL=
NETWORK=mainnet-beta              # or "devnet"

# ---------- Token ----------
PULSE_MINT_ADDRESS=               # set post-launch
PULSE_TOTAL_SUPPLY=1000000000
PULSE_DECIMALS=6

# ---------- Wallet keys (base58; keep secret) ----------
BOT_WALLET_PRIVATE_KEY=
BURN_VAULT_PRIVATE_KEY=
DEFENSE_VAULT_PRIVATE_KEY=
REWARDS_VAULT_PRIVATE_KEY=
LIQUIDITY_VAULT_PRIVATE_KEY=
OPERATIONS_VAULT_PRIVATE_KEY=

# ---------- Vault public addresses ----------
DECISION_VAULT_ADDRESS=
DEFENSE_VAULT_ADDRESS=
REWARDS_VAULT_ADDRESS=
LIQUIDITY_VAULT_ADDRESS=
OPERATIONS_VAULT_ADDRESS=

# ---------- Trading infrastructure ----------
JUPITER_API_URL=https://quote-api.jup.ag/v6
JITO_AUTH_KEYPAIR=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# ---------- Database (Replit Hosted Postgres) ----------
# Use the connection string Replit gives you under "Database" → "Connection details".
DATABASE_URL=postgres://user:password@host:5432/pulse
# Optional: separate read-only URL for dashboard tooling.
DATABASE_URL_READONLY=

# ---------- Pricing ----------
BIRDEYE_API_KEY=

# ---------- Social ----------
# Twitter is READ-ONLY (free Essential tier with Bearer token) — used only
# by the tweet-multiplier system to fetch tweet metrics. We do NOT post to
# Twitter (paid tier required). Telegram is the broadcast channel.
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ---------- Monitoring ----------
BETTERSTACK_HEARTBEAT_URL=

# ---------- Operational ----------
PORT=3001
LOG_LEVEL=info
DRY_RUN=true
DRY_RUN_TIME_SCALE=1
MAX_DAILY_SOL_DEPLOYED=50
BOT_HOT_WALLET_MAX_BALANCE_SOL=5
HELIUS_WEBHOOK_SECRET=
# Bearer used by /admin/* endpoints. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# ---------- Claude (Talk-to-PULSE chat, narration, vote debates) ----------
# Get a key at https://platform.claude.com — features no-op gracefully if unset.
ANTHROPIC_API_KEY=
# Default model is claude-haiku-4-5 (cheap + fast). Override to experiment.
ANTHROPIC_MODEL=
