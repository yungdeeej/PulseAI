modules = ["nodejs-20", "python-3.11", "postgresql-16"]
entrypoint = "apps/bot/src/index.ts"
hidden = [".pnpm-store", "node_modules", "dist", ".replit_history"]

run = "pnpm install --prefer-offline && AUTO_MIGRATE=true pnpm --filter @pulse/bot dev"

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "development"
PORT = "3001"
AUTO_MIGRATE = "true"

[deployment]
deploymentTarget = "vm"
build = ["bash", "-c", "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @workspace/blob-character build"]
run = ["bash", "-c", "AUTO_MIGRATE=true pnpm --filter @pulse/bot start"]

[deployment.env]
NODE_ENV = "production"
PORT = "3001"

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 20643
externalPort = 3000

[unitTest]
language = "nodejs"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bot (backend)"

[[workflows.workflow]]
name = "Bot (backend)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --prefer-offline && AUTO_MIGRATE=true pnpm --filter @pulse/bot dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[userenv]

